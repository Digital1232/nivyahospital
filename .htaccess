# Clean URLs for Apache/cPanel hosting (Vercel uses vercel.json instead)
Options -MultiViews
RewriteEngine On

# One official address: nivyahospitals.com -> www.nivyahospitals.com
RewriteCond %{HTTP_HOST} ^nivyahospitals\.com$ [NC]
RewriteRule ^ https://www.nivyahospitals.com%{REQUEST_URI} [R=301,L,NE]

# Old links: /about-us.html -> /about-us, /index.html -> /
RewriteCond %{THE_REQUEST} \s/+(.*?/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Serve /about-us from about-us.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
