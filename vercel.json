{
	"cleanUrls": true,
	"trailingSlash": false,
	"regions": ["sin1"],
	"redirects": [
		{ "source": "/doctor-naveen-paul-profile", "destination": "/dentistry", "permanent": true }
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{ "key": "X-Frame-Options", "value": "SAMEORIGIN" },
				{ "key": "X-Content-Type-Options", "value": "nosniff" },
				{ "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
			]
		}
	]
}
